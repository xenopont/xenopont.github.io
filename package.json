{
  "name": "xenopont.github.io",
  "type": "module",
  "version": "1.0.0",
  "description": "xenopont.github.io",
  "main": "index.html",
  "scripts": {
    "build": "./node_modules/.bin/tsx src/build.ts",
    "build:xenopont": "DOMAIN_NAME=xenopont.github.io ./node_modules/.bin/tsx src/build.ts",
    "build:dev-xl": "DOMAIN_NAME=dev-xl.com ./node_modules/.bin/tsx src/build.ts",
    "http": "./node_modules/.bin/http-server --cors ./dist/",
    "tsx-watch": "./node_modules/.bin/tsx watch --include 'src/**/*' src/build.ts",
    "type-check": "./node_modules/.bin/tsc --noEmit",
    "watch": "npm run http & npm run tsx-watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenopont/xenopont.github.io.git"
  },
  "author": "Sergei Kovalenko",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xenopont/xenopont.github.io/issues"
  },
  "homepage": "https://github.com/xenopont/xenopont.github.io#readme",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.3.2",
    "esbuild": "0.27.3",
    "highlight.js": "11.11.1",
    "htmlfy": "^1.0.1",
    "http-server": "14.1.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
